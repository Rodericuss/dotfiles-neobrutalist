configuration { modi: "drun,run";
    show-icons: true;
    font: "GeistMono Nerd Font 12";
    icon-theme: "Papirus";
    }
* { bg: #f0e1d6;
    fg: #241d1b;
    accent: #c5dea8;
    background-color: @bg;
    text-color: @fg;
    }
window { width: 620px;
    border: 3px;
    border-color: @fg;
    border-radius: 14px;
    padding: 20px;
    }
mainbox { spacing: 16px;
    }
inputbar { children: [prompt, entry];
    padding: 12px;
    border: 2px;
    border-color: @fg;
    border-radius: 8px;
    background-color: #fff4ea;
    }
prompt { background-color: inherit;
    margin: 0 12px 0 0;
    }
entry { background-color: inherit;
    placeholder: "Find an application…";
    }
listview { lines: 7;
    spacing: 8px;
    }
element { padding: 12px;
    border: 2px;
    border-color: @bg;
    border-radius: 8px;
    }
element selected { background-color: @accent;
    border-color: @fg;
    }
element-icon { size: 26px;
    margin: 0 12px 0 0;
    background-color: inherit;
    }
element-text { background-color: inherit;
    text-color: inherit;
    }

window { background-color: @bg; }
listview { border: 0; }
element normal.normal, element alternate.normal, element normal.active, element alternate.active {
 background-color: @bg;
 text-color: @fg;
}
element selected.normal, element selected.active {
 background-color: @accent;
 text-color: @fg;
 border-color: @fg;
}
